	partition Calendario = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(DATE(2020, 1, 1), DATE(2023, 1, 31)),
				    "Ano", YEAR([Date]),
				    "MesNumero", MONTH([Date]),
				    "Mes", FORMAT([Date], "MMM"),
				    "AnoMes", FORMAT([Date], "YYYY-MM")
				)

	annotation PBI_Id = d74b250c242f4e1e9238c69ce71945b5

